{# .main-footer .pale #}

<div class="footer-topnav">

  {% if page.url != '/' %}
  <a class="homelink" href="/">hans.gerwitz.com</a>
  {% endif %}

  {% if page.url != '/search/' %}
  <form action="/search/" method="get">
    <div class="search-form{{ ' home' if page.url == '/' }}" role="search">
      <input type="text" aria-label="Search this site" placeholder="Search" autocomplete="off" autocapitalize="off" spellcheck="false" name="q">
      <button type="submit" aria-label="search"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 13 13"><g stroke-width="2" fill="none"><path d="M11.29 11.71l-4-4"/><circle cx="5" cy="5" r="4"/></g></svg></button>
    </div>
  </form>
  {% endif %}
</div>

<div class="footer-content">
  <div class="toy" data-footer-toy></div>

  <div class="sitemap">
    <dl class="published">
      <dt>{{ "writing" | navpath(data.breadcrumbs) | safe }}</dt>
      <dd>{{ collections.writing | length }} blog posts</dd>

      <dt>{{ "notes" | navpath(data.breadcrumbs) | safe }}</dt>
      <dd>{{ collections.notes | length }} short notes</dd>

      <dt>{{ "projects" | navpath(data.breadcrumbs) | safe }}</dt>
      <dd>Documented projects</dd>
{#
      <dt>{{ "ideas" | navpath(data.breadcrumbs) | safe }}</dt>
      <dd>Opinions on things</dd>
 #}
      <dt>{{ "lists" | navpath(data.breadcrumbs) | safe }}</dt>
      <dd>Other lists</dd>
    </dl>

    <dl class="personal">
      <dt>{{ "about" | navpath(eleventyComputed.crumbtrail) | safe }}</dt>
      <dd>About me</dd>

      <dt>{{ "logs" | navpath(eleventyComputed.crumbtrail) | safe }}</dt>
      <dd>Personal history</dd>
{#
      <dt>{{ "weeks" | navpath(eleventyComputed.crumbtrail) | safe }}</dt>
      <dd>Weeknotes</dd>
 #}
      <dt>{{ "site" | navpath(eleventyComputed.crumbtrail) | safe }}</dt>
      <dd>About this site</dd>

      <dt>{{ "follow" | navpath(eleventyComputed.crumbtrail) | safe }}</dt>
      <dd>Where to find me</dd>
    </dl>
  </div>
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const footerToy = document.querySelector("[data-footer-toy]");
    const availableToys = [
    {% for toy in collections.toys %}
      {% if toy.url != page.url %}
      {
        title: {{ toy.data.title | json | safe }},
        slug: {{ toy.data.toySlug | json | safe }},
        url: {{ toy.url | json | safe }},
        embed: {{ toy.data.toyEmbed | json | safe }},
      },
      {% endif %}
    {% endfor %}
    ];

    if (!footerToy || !availableToys.length) {
      return;
    }

    const toy = availableToys[Math.floor(Math.random() * availableToys.length)];
    const screen = document.createElement("div");
    const embed = document.createElement("iframe");
    const name = document.createElement("div");
    const toysLink = document.createElement("a");
    const toyLink = document.createElement("a");

    screen.className = "toy-screen";
    embed.className = "toy-embed";
    embed.src = `${toy.embed}&size=128`;
    embed.title = `${toy.title}`;
    name.className = "toy-name";
    toysLink.href = "/toys/";
    toysLink.textContent = "/toys";
    toyLink.href = toy.url;
    toyLink.textContent = `/${toy.slug}`;

    name.append(toysLink, toyLink);
    screen.append(embed);
    footerToy.append(screen, name);
  }, { once: true });
</script>

