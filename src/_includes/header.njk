{# .main-header .pale #}
<span class="site-title">{% tree 32 %}</span>
<div class="breadcrumb">
  <a class="internal path" href="/"><span class="slash">/</span></a>
  {% if not breadcrumbs %}
    {% set breadcrumbs = page.url.split('/').slice(1,-1) %}
  {% endif %}
  {% set crumbPath = '/' %}
  {% for crumb in breadcrumbs %}
    {% set crumbPath = crumbPath + crumb + '/' %}
    {% if loop.last %}
      {# Ancestors above are always directories; this one only earns the
         trailing slash if pages are published beneath it. #}
      <span class="internal">{{ crumb }}{{ '/' if (crumbPath | isdirectory) else '' }}</span>
    {% else %}
      <a class="internal path" href="{{ crumbPath }}">{{ crumb }}<span class="slash">/</span></a>
    {% endif %}
  {% endfor %}
</div>
