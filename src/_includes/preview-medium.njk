{% set previewTitle = item.data.title or item.fileSlug %}
{# Keep this icon markup in sync with the icon mapping in eleventy/shortcodes/previews.js. #}
<article class="preview preview-medium">
  <h3><span class="preview-icon" aria-hidden="true" style="--preview-icon: url('/styles/icons/{{ item.data.previewIconName or 'other' }}.png')"></span><a href="{{ item.url }}">{{ previewTitle }}</a></h3>
  {% if item.data.contentDate or item.data.wordCount %}
  <p class="preview-meta">
    {% if item.data.contentDate %}
    <time datetime="{{ item.data.contentDate | date('iso8601') }}">{{ item.data.contentDate | date('MMMM Do, YYYY') }}</time>
    {% endif %}
    {% if item.data.contentDate and item.data.wordCount %} · {% endif %}
    {% if item.data.wordCount %}{{ item.data.wordCount }} words{% endif %}
  </p>
  {% endif %}
</article>
