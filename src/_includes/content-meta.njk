{# Keep src/site/styles.njk's content metadata sample in sync with this template and test the proofsheet after changes. #}
{% set relatedSource = related.sources[page.url] %}
{% set isDatedContent = bodyClass == "writing" or bodyClass == "note" %}
{% set hasCrossposts = crossposts and crossposts.length %}
{% set hasRelatedContent = relatedSource and relatedSource.related.length %}
{% set knownTopics = topics | filterKnownTopics(collections.topics) %}
{% set hasKnownTopics = knownTopics.length %}
{% if isDatedContent or hasRelatedContent %}
<div class="content-meta">
  <div>
    {% if isDatedContent %}
    Posted{% if hasKnownTopics %} to {% for topicSlug in knownTopics %}{% if not loop.first %}{% if loop.last and knownTopics.length > 2 %}, {% endif %}{% if loop.last %}and {% else %}, {% endif %}{% endif %}{% for topic in collections.topics %}{% if topic.data.topicSlug == topicSlug %}<a href="{{ topic.url }}">{{ topic.data.title }}</a>{% endif %}{% endfor %}{% endfor %}{% endif %} during {{ page.date | weeklink | safe }} ({{ page.date | date("MMMM YYYY") }})
    {%- if hasCrossposts -%}
      , also on:
      <ul>
        {% for target in crossposts -%}
          <li><a href="{{ target }}">{{ target | hostname }}</a></li>
        {%- endfor %}
      </ul>
    {% endif %}
    {% endif %}

    {% if isDatedContent and hasRelatedContent %}
    <hr class="content-meta-separator">
    {% endif %}

    {% if hasRelatedContent %}
    <section class="related-content">
      Related pages:
      <ul>
      {% for item in relatedSource.related %}
        <li class="{{ item.kind }}" data-score="{{ item.score }}">
          <a href="{{ item.url }}">{{ item.title }}</a>
        </li>
      {% endfor %}
      </ul>
    </section>
    {% endif %}

  </div>
</div>
{% endif %}
