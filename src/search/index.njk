---
title: Search
layout: index
eleventyExcludeFromCollections: true
---

<form action="?" method="get">
  <div class="search-form" role="search">
    <input type="search" aria-label="Search this site" placeholder="Search this site" autocorrect="off" autocapitalize="off" autocomplete="off" spellcheck="false" name="q">
    <button type="submit" aria-label="Search"></button>
  </div>
</form>

<section id="search-results" aria-live="polite">
  <p class="message"></p>
  <div class="results"></div>
</section>

<script type="module">
  const queryElement = document.querySelector(".search-form input");
  const messageElement = document.querySelector("#search-results .message");
  const resultsElement = document.querySelector("#search-results .results");
  const query = new URLSearchParams(window.location.search).get("q")?.trim();

  const showMessage = (message) =>
  {
    messageElement.textContent = message;
  };

  const showResults = (results) =>
  {
    const list = document.createElement("ol");
    list.className = "article-list";

    for (const result of results)
    {
      const item = document.createElement("li");
      const link = document.createElement("a");
      const title = document.createElement("span");
      title.className = "title";
      title.textContent = result.meta.title || "Untitled";
      link.href = result.url;
      link.append(title);
      item.append(link);

      if (result.meta.date)
      {
        const date = document.createElement("span");
        date.className = "meta";
        date.textContent = ` (${new Date(result.meta.date).toLocaleDateString("en-US", {
          day: "numeric",
          month: "long",
          year: "numeric",
        })})`;
        item.append(date);
      }

      if (result.meta.summary)
      {
        const summary = document.createElement("p");
        summary.textContent = result.meta.summary;
        item.append(summary);
      }

      list.append(item);
    }

    resultsElement.replaceChildren(list);
  };

  const search = async () =>
  {
    if (!query)
    {
      return;
    }

    queryElement.value = query;
    showMessage("Loading…");

    try
    {
      const pagefind = await import("/pagefind/pagefind.js");
      await pagefind.options({
        ranking: {
          metaWeights: {
            title: 5,
            topics: 3,
          },
        },
      });
      const response = await pagefind.search(query);
      const results = await Promise.all(response.results.map((result) => result.data()));

      if (!results.length)
      {
        showMessage("No results, sorry.");
        return;
      }

      showMessage(`${results.length} ${results.length === 1 ? "result" : "results"}:`);
      showResults(results);
    }
    catch (error)
    {
      console.error(error);
      showMessage("Unable to load the search index.");
    }
  };

  search();
</script>
