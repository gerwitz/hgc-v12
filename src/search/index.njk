---
title: Search
layout: index
eleventyExcludeFromCollections: true
---

<div class="footer-topnav">
  <form action="?" method="get">
    <div class="search-form home" role="search">
      <input type="search" aria-label="Search this site" placeholder="Search" autocorrect="off" autocapitalize="off" autocomplete="off" spellcheck="false" name="q">
      <button type="submit" aria-label="Search"></button>
    </div>
  </form>
</div>

<section id="search-results" aria-live="polite">
  <p class="message"></p>
  <div class="results"></div>
</section>

<script type="module">
  const queryElement = document.querySelector(".search-form input");
  const messageElement = document.querySelector("#search-results .message");
  const resultsElement = document.querySelector("#search-results .results");
  const query = new URLSearchParams(window.location.search).get("q")?.trim();

  const showMessage = (message) =>
  {
    messageElement.textContent = message;
  };

  const formatDate = (value) =>
  {
    const date = new Date(value);
    const day = date.getDate();
    const tens = day % 100;
    const suffix = tens >= 11 && tens <= 13
      ? "th"
      : ["th", "st", "nd", "rd"][day % 10] || "th";

    return `${date.toLocaleDateString("en-US", { month: "long" })} ${day}${suffix}, ${date.getFullYear()}`;
  };

  const showResults = (results) =>
  {
    const previews = document.createDocumentFragment();
    const iconNames = new Set(["culture", "list", "log", "note", "other", "personal", "project", "work"]);

    for (const result of results)
    {
      const preview = document.createElement("article");
      const heading = document.createElement("h3");
      const icon = document.createElement("span");
      const link = document.createElement("a");
      const iconName = iconNames.has(result.meta.icon) ? result.meta.icon : "other";
      preview.className = "preview preview-large";
      icon.className = "preview-icon";
      icon.setAttribute("aria-hidden", "true");
      icon.style.setProperty("--preview-icon", `url('/styles/icons/${iconName}.png')`);
      link.href = result.url;
      link.textContent = result.meta.title || "Untitled";
      heading.append(icon, link);
      preview.append(heading);

      if (result.meta.date || result.meta.wordCount)
      {
        const metadata = document.createElement("p");
        metadata.className = "preview-meta";

        if (result.meta.date)
        {
          const time = document.createElement("time");
          time.dateTime = result.meta.date;
          time.textContent = formatDate(result.meta.date);
          metadata.append(time);
        }

        if (result.meta.date && result.meta.wordCount)
        {
          metadata.append(" · ");
        }

        if (result.meta.wordCount)
        {
          metadata.append(`${result.meta.wordCount} words`);
        }

        preview.append(metadata);
      }

      const fallbackSummary = result.meta.description || (result.meta.date ? formatDate(result.meta.date) : "");
      const hasRenderedExcerpt = result.meta.hasBody === "true" && result.excerpt;
      if (hasRenderedExcerpt || fallbackSummary)
      {
        const summary = document.createElement("p");
        summary.className = "preview-summary";

        if (hasRenderedExcerpt)
        {
          // Pagefind escapes indexed HTML before adding safe match-highlighting markup.
          summary.innerHTML = result.excerpt;
        }
        else
        {
          summary.textContent = fallbackSummary;
        }

        preview.append(summary);
      }

      previews.append(preview);
    }

    resultsElement.replaceChildren(previews);
  };

  const search = async () =>
  {
    if (!query)
    {
      return;
    }

    queryElement.value = query;
    showMessage("Loading…");

    try
    {
      const pagefind = await import("/pagefind/pagefind.js");
      await pagefind.options({
        ranking: {
          metaWeights: {
            categories: 1.5,
            date: 0,
            description: 1,
            hasBody: 0,
            icon: 0,
            kind: 1,
            neighbors: 0.35,
            title: 5,
            topics: 3,
            wordCount: 0,
          },
        },
      });
      const response = await pagefind.search(query);
      const results = await Promise.all(response.results.map((result) => result.data()));

      if (!results.length)
      {
        showMessage("No results, sorry.");
        return;
      }

      showMessage(`${results.length} ${results.length === 1 ? "result" : "results"}:`);
      showResults(results);
    }
    catch (error)
    {
      console.error(error);
      showMessage("Unable to load the search index.");
    }
  };

  search();
</script>
