---
permalink: /feeds/everything.rss
eleventyExcludeFromCollections: true
layout: false
feedmeta:
  title: "hans.gerwitz.com — everything"
  url: https://hans.gerwitz.com
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ feedmeta.title | escape }}</title>
    <link>{{ feedmeta.url | escape }}/site/content/</link>
    <atom:link href="{{ feedmeta.url | escape }}/feeds/everything.rss" rel="self" type="application/rss+xml" />
    <description>Everything from hans.gerwitz.com, including Gemini-only posts.</description>
    {% if contentFeed[0].pubDate %}<pubDate>{{ contentFeed[0].pubDate | escape }}</pubDate>{% endif %}
    {% for item in contentFeed %}
    <item>
      <title>{{ item.title | escape }}</title>
      <link>{{ item.url | escape }}</link>
      <guid isPermaLink="true">{{ item.guid | escape }}</guid>
      {% if item.pubDate %}<pubDate>{{ item.pubDate | escape }}</pubDate>{% endif %}
      {% if item.description %}<description>{{ item.description | escape }}</description>{% endif %}
    </item>
    {% endfor %}
  </channel>
</rss>
