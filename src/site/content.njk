---
title: Searchable Pages
layout: page
eleventyExcludeFromCollections: true
---

<p>
  <img src="https://hans.gerwitz.com/.well-known/calmserve/updated.svg" alt="calmserve update badge" style="width: auto;">
</p>

{% for group in contentGroups %}
<details>
  <summary>{{ group.title }} ({{ group.items.length }})</summary>
  <table>
    <thead>
      <tr>
        {% if group.hasDatedItems %}<th>Date</th>{% endif %}
        <th>Name</th>
        <th>URL</th>
      </tr>
    </thead>
    <tbody>
    {% for item in group.items %}
      <tr>
        {% if group.hasDatedItems %}<td>{% if item.data.contentDate %}{{ item.data.contentDate | date("YYYY-MM-DD") }}{% endif %}</td>{% endif %}
        <td>{{ item.data.title or item.fileSlug }}</td>
        <td><a href="{{ item.url }}"{% if item.url.startsWith("gemini://") %} class="gemini-link" title="Gemini-only post"{% endif %}>{{ item.url }}</a></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</details>
{% endfor %}
