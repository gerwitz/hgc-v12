{
  "name": "hans.gerwitz.com",
  "version": "12.1.1",
  "description": "Personal website",
  "author": "Hans Gerwitz",
  "license": "CC-BY-4.0",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "eleventy && npm run search:index",
    "test": "node --test test/*.test.js",
    "start": "eleventy --serve",
    "generate:maps": "npm run content:prepare",
    "related": "npm run content:prepare",
    "related:check": "node scripts/related-content.js --dry-run",
    "search:index": "node scripts/search-index.js",
    "gemini:ping": "node scripts/gemini-ping.mjs",
    "content:prepare": "node --env-file-if-exists=.env scripts/prepare-content.mjs",
    "content:check": "node --env-file-if-exists=.env scripts/prepare-content.mjs --check",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('scripts/install-hooks.mjs')) await (await import('./scripts/install-hooks.mjs')).installHooks();\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gerwitz/hgc-12"
  },
  "dependencies": {
    "@11ty/eleventy": "^4.0.0-alpha.10",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "browserslist": "^4.25.2",
    "core-js": "^3.36.0",
    "d3": "^6.7.0",
    "eleventy-nbsp-filter": "^0.1.0",
    "h3-js": "^4.1.0",
    "javascript-stringify": "^2.1.0",
    "js-yaml": "^4.3.2",
    "lightningcss": "^1.30.1",
    "linkedom": "^0.15.6",
    "markdown-it-anchor": "^8.6.4",
    "markdown-it-attribution": "^0.1.4",
    "markdown-it-deflist": "^2.1.0",
    "markdown-it-footnote-here": "^1.0.3",
    "markdown-it-implicit-figures": "^0.10.0",
    "markdown-it-link-attributes": "^4.0.1",
    "moment": "^2.29.1",
    "moment-timezone": "^0.6.4",
    "nunjucks": "^3.2.4",
    "pagefind": "^1.5.2",
    "tap-spot": "^1.1.1",
    "twix": "^1.3.0"
  },
  "devDependencies": {
    "dictionary-en": "^3.2.0",
    "dictionary-nl": "^1.6.0",
    "textlint": "^12.1.1",
    "textlint-rule-spelling": "^0.3.0",
    "textlint-rule-write-good": "^2.0.0"
  }
}
